# Copy to .env if you want to change these. Nothing here is secret; Hyperliquid's API needs no key.

# Port the backend relay listens on (the web app connects to ws://localhost:<RELAY_PORT>/ws)
RELAY_PORT=8787

# Set to 1 to run a fake trade feed instead of Hyperliquid (offline UI work)
FAKE=0

# Comma-separated coins to stream
COINS=BTC,ETH,SOL

# SQLite file
DB_PATH=data/tape.db
