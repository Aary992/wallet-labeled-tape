{
  "name": "@tape/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "dev:fake": "tsx watch --env-file-if-exists=../.env src/index.ts --fake",
    "start": "tsx --env-file-if-exists=../.env src/index.ts",
    "probe": "tsx src/probe.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "dev:replay": "tsx --env-file-if-exists=../.env src/index.ts --replay latest",
    "replay:record": "tsx src/scripts/record-replay.ts",
    "freeze": "tsx --env-file-if-exists=../.env src/scripts/freeze-cohort.ts",
    "preseed": "tsx --env-file-if-exists=../.env src/scripts/preseed.ts",
    "forward-test": "tsx --env-file-if-exists=../.env src/scripts/forward-test.ts"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
